.page { min-height: 100vh; padding: 16px; background: #fff; box-sizing: border-box; }
.cover { width: 100%; height: 180px; border-radius: 12px; }
.title { margin-top: 14px; font-size: 20px; font-weight: 700; }
.summary { margin-top: 8px; color: #8a8f98; font-size: 14px; }
.body { margin-top: 14px; font-size: 15px; line-height: 1.7; white-space: pre-wrap; }
