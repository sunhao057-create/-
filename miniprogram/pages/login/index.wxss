.wrap {
  min-height: 100vh;
  padding: 48px 24px 40px;
  background: linear-gradient(160deg, #dbeafe, #fdf2f8 40%, #e0f2fe);
  box-sizing: border-box;
}

.brand {
  margin-bottom: 28px;
  color: #0f172a;
}

.name {
  font-size: 28px;
  font-weight: 700;
}

.hint {
  margin-top: 8px;
  font-size: 13px;
  color: #64748b;
  line-height: 1.5;
}

.card {
  background: #fff;
  border-radius: 18px;
  padding: 22px 18px 24px;
  box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
}

.title {
  font-size: 20px;
  font-weight: 650;
  margin-bottom: 16px;
}

.input {
  height: 48px;
  border-radius: 12px;
  background: #f8fafc;
  padding: 0 14px;
  margin-bottom: 12px;
  font-size: 15px;
}

.error {
  color: #e11d48;
  font-size: 13px;
  margin-bottom: 12px;
}

.btn {
  margin-top: 8px;
  background: #2563eb;
  color: #fff;
  border-radius: 12px;
  height: 48px;
  line-height: 48px;
  font-size: 16px;
}

.btn::after {
  border: 0;
}
