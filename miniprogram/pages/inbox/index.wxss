.page {
  min-height: 100vh;
  padding: 12px 16px 24px;
  padding-bottom: calc(140px + constant(safe-area-inset-bottom));
  padding-bottom: calc(140px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.chips {
  white-space: nowrap;
  margin-bottom: 8px;
}

.chip {
  display: inline-block;
  margin-right: 8px;
  border-radius: 999px;
  padding: 8px 14px;
  background: #e8eef6;
  color: #475569;
  font-size: 13px;
}

.chip.on {
  background: #2563eb;
  color: #fff;
}

.filter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 4px 12px;
  font-size: 13px;
  color: #64748b;
}

.empty {
  padding: 48px 0;
  text-align: center;
  color: #94a3b8;
}

.todo {
  background: #fff;
  border-radius: 16px;
  padding: 14px;
  margin-bottom: 10px;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
}

.h {
  font-size: 16px;
  font-weight: 650;
}

.p {
  margin-top: 6px;
  font-size: 13px;
  color: #64748b;
}

.meta {
  margin-top: 10px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.pill {
  font-size: 11px;
  color: #475569;
  background: #f1f5f9;
  border-radius: 999px;
  padding: 3px 8px;
}

.warn {
  background: #fff7ed;
  color: #c2410c;
}
