<view class="page">
  <view class="bar">
    <input class="search" placeholder="搜索" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" bindconfirm="reload" />
    <button wx:if="{{canCreate}}" class="add" bindtap="create">新建</button>
  </view>
  <view wx:if="{{loading && !rows.length}}" class="empty">加载中…</view>
  <view wx:elif="{{!rows.length}}" class="empty">暂无数据</view>
  <view wx:for="{{rows}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openItem">
    <view class="h">{{item.titleText}}</view>
    <view class="p">{{item.subText}}</view>
  </view>
</view>
