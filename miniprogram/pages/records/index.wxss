.page { min-height: 100vh; padding: 16px; background: #f6f7f9; box-sizing: border-box; }
.head { font-size: 20px; font-weight: 700; }
.hint { margin: 8px 0 14px; color: #8a8f98; font-size: 13px; line-height: 1.5; }
.card { background: #fff; border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; }
.title { font-size: 16px; font-weight: 650; }
.device, .line, .extra { margin-top: 4px; color: #64748b; font-size: 13px; }
.empty { margin-top: 28px; text-align: center; color: #8a8f98; font-size: 14px; }
