.page { min-height: 100vh; padding: 16px 16px 220px; box-sizing: border-box; background: #f6f7f9; }
.card { background: #fff; border-radius: 14px; padding: 14px 16px; margin-bottom: 12px; }
.title { font-size: 16px; font-weight: 650; margin-bottom: 8px; }
.hint, .meta, .muted { color: #64748b; font-size: 13px; line-height: 1.5; }
.name { font-size: 18px; font-weight: 650; }
.field { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid #f1f5f9; }
.field.column { flex-direction: column; align-items: stretch; }
.lab { width: 96px; flex: none; color: #334155; font-size: 14px; }
.field input, .placeholder { flex: 1; font-size: 14px; }
.placeholder { color: #94a3b8; }
.area { width: 100%; min-height: 72px; margin-top: 8px; background: #f8fafc; border-radius: 10px; padding: 8px 10px; box-sizing: border-box; }
.photos { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.photo { width: 72px; height: 72px; border-radius: 8px; overflow: hidden; }
.photo-img { width: 72px; height: 72px; }
.add { display: flex; align-items: center; justify-content: center; background: #f8fafc; color: #64748b; font-size: 12px; border: 1px dashed #cbd5e1; }
.btn { margin-top: 12px; background: #f5a623; color: #fff; border-radius: 12px; }
.btn.ghost { background: #fff; color: #334155; border: 1px solid #e2e8f0; }
.btn::after { border: 0; }
