.page { min-height: 100vh; padding: 12px 16px 24px; background: #f6f7f9; }
.item { display: flex; gap: 12px; background: #fff; border-radius: 12px; padding: 12px; margin-bottom: 10px; }
.pic { width: 96px; height: 72px; border-radius: 8px; background: #f5a623; }
.txt { flex: 1; }
.title { font-size: 16px; font-weight: 650; }
.sum { margin-top: 6px; color: #8a8f98; font-size: 13px; }
.empty { color: #8a8f98; font-size: 14px; line-height: 1.6; padding: 24px 8px; }
