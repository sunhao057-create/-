<view class="page">
  <view wx:if="{{!rows.length}}" class="empty">还没有{{title}}。请在电脑端「客户小程序」里提交。</view>
  <view class="item" wx:for="{{rows}}" wx:key="id" bindtap="open" data-id="{{item.id}}">
    <image wx:if="{{item.image}}" class="pic" src="{{item.image}}" mode="aspectFill" />
    <view class="txt">
      <view class="title">{{item.title}}</view>
      <view class="sum" wx:if="{{item.summary}}">{{item.summary}}</view>
    </view>
  </view>
</view>
