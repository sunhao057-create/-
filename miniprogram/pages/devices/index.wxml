<view class="page safe-pad">
  <view class="hero">
    <view class="company">{{companyName || '设备服务'}}</view>
    <view class="count">{{total}}</view>
    <view class="unit">台设备</view>
  </view>
  <view wx:if="{{loading}}" class="empty">加载中</view>
  <view wx:elif="{{empty}}" class="empty">{{empty}}</view>
  <view wx:else class="list">
    <view class="item" wx:for="{{devices}}" wx:key="id" bindtap="open" data-id="{{item.id}}">
      <view class="name">{{item.name || '未命名设备'}}</view>
      <view class="meta">{{item.code}} · {{item.statusLabel}}</view>
      <view class="meta" wx:if="{{item.location}}">{{item.location}}</view>
    </view>
  </view>
  <tab-bar active="devices" />
</view>
