.page { min-height: 100vh; padding: 12px 16px 220px; background: #f6f7f9; box-sizing: border-box; }
.banner { width: 100%; height: 140px; border-radius: 12px; }
.ph { display: flex; align-items: center; justify-content: center; background: #f5a623; color: #fff; font-size: 28px; font-weight: 800; }
.section { margin: 16px 0 10px; padding-left: 8px; border-left: 4px solid #2f6bff; font-weight: 700; }
.grid { display: flex; flex-wrap: wrap; gap: 12px; }
.tile { position: relative; width: calc(50% - 6px); height: 84px; border-radius: 10px; overflow: hidden; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 16px; font-weight: 650; }
.tile-bg { position: absolute; left: 0; top: 0; width: 100%; height: 84px; }
.tile-title { position: relative; z-index: 1; }
.orange { background: #f5a623; }
.gray { background: #8e8e8e; }
.pair { display: flex; gap: 12px; flex-wrap: wrap; }
.card { width: calc(50% - 6px); }
.cover { width: 100%; height: 88px; border-radius: 8px; background: #f5a623; }
.ph-sm { display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; }
.cap { display: block; margin-top: 6px; text-align: center; font-size: 13px; }
.empty { color: #8a8f98; font-size: 13px; line-height: 1.6; }
