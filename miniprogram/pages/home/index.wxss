.page { min-height: 100vh; padding: 12px 16px 220px; box-sizing: border-box; background: #f6f7f9; }
.banner { height: 168px; border-radius: 12px; overflow: hidden; }
.slide { width: 100%; height: 168px; }
.ph {
  display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
  padding: 20px; box-sizing: border-box;
  background: linear-gradient(120deg, #f6b43c, #f08a1a 55%, #2f6bff);
  color: #fff;
}
.brand { font-size: 13px; }
.hero { margin-top: 8px; font-size: 36px; font-weight: 800; }
.notice {
  display: flex; align-items: center; gap: 8px;
  margin-top: 12px; padding: 8px 12px; background: #fff; border-radius: 20px; color: #8a8f98; font-size: 13px;
}
.horn { color: #2f6bff; font-weight: 700; }
.notice-text { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.section { margin: 18px 0 10px; padding-left: 8px; border-left: 4px solid #2f6bff; font-size: 16px; font-weight: 700; }
.grid { display: flex; flex-wrap: wrap; gap: 12px; }
.tile {
  width: calc(50% - 6px); height: 108px; border-radius: 12px;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: #fff; font-size: 16px; font-weight: 650;
}
.orange { background: #f5a623; }
.gray { background: #8e8e8e; }
.mark {
  width: 36px; height: 36px; margin-bottom: 8px; border: 2px solid #fff; border-radius: 8px;
  line-height: 32px; text-align: center; font-size: 16px;
}
.pair { display: flex; gap: 12px; }
.card { flex: 1; }
.cover { width: 100%; height: 92px; border-radius: 8px; background: #f5a623; }
.ph-sm { display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; }
.gold { background: #f0b429; }
.cap { display: block; margin-top: 6px; text-align: center; font-size: 13px; color: #333; }
