.dock {
  height: 0;
  overflow: visible;
}

.tabs {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  pointer-events: auto;
  display: flex;
  align-items: flex-end;
  height: 64px;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1px solid #f0f0f0;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 52px;
  color: #9aa0a6;
  font-size: 11px;
}

.tab.on,
.on-text {
  color: #f5b400;
  font-weight: 600;
}

.ico {
  font-size: 18px;
  line-height: 1;
  margin-bottom: 2px;
}

.mid {
  position: relative;
  top: -10px;
}

.hub {
  width: 52px;
  height: 52px;
  margin-bottom: 2px;
  border-radius: 16px;
  background: #f5c518;
  color: #1f1f1f;
  font-size: 18px;
  font-weight: 700;
  line-height: 52px;
  text-align: center;
  box-shadow: 0 6px 16px rgba(245, 197, 24, 0.45);
}

.hub.on {
  background: #f0b400;
}
